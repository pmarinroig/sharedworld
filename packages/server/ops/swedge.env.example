# /etc/sharedworld/swedge.env — environment for swedge.service
SW_EDGE_ACME_DOMAINS=api.sharedworld.example
SW_EDGE_ACME_EMAIL=you@example.com
SW_EDGE_ACME_CACHE=/var/lib/sharedworld/acme
# Staging certs until the rehearsal passes, then prod (Let's Encrypt rate limits!).
SW_EDGE_ACME_PROD=false
SW_EDGE_CORE_WAIT_SECS=10
# Socket admission caps (429 + Retry-After above them; clients back off).
SW_EDGE_MAX_WS_CONNS=20000
SW_EDGE_MAX_WS_PER_IP=64
