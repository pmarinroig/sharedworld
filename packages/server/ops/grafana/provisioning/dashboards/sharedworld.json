    {
      "type": "timeseries",
      "title": "5xx + Drive failures /s",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m]))",
          "refId": "A",
          "legendFormat": "http 5xx"
        },
        {
          "expr": "sum(rate(drive_requests_total{status=~\"4xx|5xx|error\"}[5m]))",
          "refId": "B",
          "legendFormat": "drive failures"
